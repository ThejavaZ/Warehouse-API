# Copia este archivo a .env y ajusta los valores.
# .env está en .gitignore: nunca se sube al repositorio.
#
#   cp .env.example .env

POSTGRES_DB=warehouse_db
POSTGRES_USER=warehouse_user
POSTGRES_PASSWORD=cambia_esto_en_desarrollo

# Secreto HMAC-SHA256 con el que se firman los JWT. Obligatorio (mínimo 32 caracteres)
# y nunca se versiona. Genera uno con:
#   openssl rand -hex 32
AUTH_SECRET=cambia_esto_por_un_secreto_de_32_o_mas_caracteres

# Development habilita Swagger y los logs detallados.
# Usa Production desplegando en un entorno real.
ASPNETCORE_ENVIRONMENT=Development

# Opcional (solo Production): orígenes con acceso cross-origin.
# Vacío o sin definir = ninguna petición externa está permitida.
# CORS_ALLOWED_ORIGINS=https://app.example.com

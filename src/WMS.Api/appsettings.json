{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Secreto HMAC-SHA256 de los JWT: obligatorio (mínimo 32 caracteres) y nunca se versiona.
  // En desarrollo se fija con `dotnet user-secrets set "Auth:Secret" "<valor>" --project src/WMS.Api`
  // y en despliegue con la variable de entorno Auth__Secret (ver .env.example).
  // "Auth": {
  //   "Secret": "<32 o más caracteres>",
  //   "Issuer": "WarehouseApi",
  //   "Audience": "WarehouseApi.Client",
  //   "AccessTokenMinutes": 15,
  //   "RefreshTokenDays": 7,
  //   "RegistrationEnabled": true
  // },
  // Rate limiting por IP en ventana fija (valores por defecto; /api/Auth usa su propio contador).
  "RateLimit": {
    "PermitLimit": 100,
    "AuthPermitLimit": 10,
    "WindowSeconds": 60
  },
  // Solo se usan fuera de Development; vacío = ninguna petición cross-origin permitida.
  "Cors": {
    "AllowedOrigins": []
  }
}

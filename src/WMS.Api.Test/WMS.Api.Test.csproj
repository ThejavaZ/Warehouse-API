<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <!-- WebApplicationFactory<T> para arrancar la API en memoria. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
    <!-- SQLite en memoria sustituye a PostgreSQL dentro de las pruebas. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- DTOs y casos de uso (UserViewModel, UserCreateDTO…) viven en WMS.Application. -->
    <ProjectReference Include="..\WMS.Application\WMS.Application.csproj" />
    <!-- Entidades (User, RefreshToken) que siembran las pruebas. -->
    <ProjectReference Include="..\WMS.Domain\WMS.Domain.csproj" />
    <!-- AppDbContext y los repositorios concretos viven en WMS.Infrastructure. -->
    <ProjectReference Include="..\WMS.Infrastructure\WMS.Infrastructure.csproj" />
    <!-- Program (el host) vive en WMS.Api: es el tipo de WebApplicationFactory<T>. -->
    <ProjectReference Include="..\WMS.Api\WMS.Api.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.9.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Api.csproj" />
    <!-- DTOs, casos de uso y puertos (Users, Common) viven en WMS.Application. -->
    <ProjectReference Include="..\WMS.Application\WMS.Application.csproj" />
    <!-- Entidades (User, RefreshToken) y DomainException viven en WMS.Domain. -->
    <ProjectReference Include="..\WMS.Domain\WMS.Domain.csproj" />
    <!-- AppDbContext y los repositorios concretos viven en WMS.Infrastructure. -->
    <ProjectReference Include="..\WMS.Infrastructure\WMS.Infrastructure.csproj" />
    <!-- Program (el host) vive en WMS.Api: es el tipo de WebApplicationFactory<T>. -->
    <ProjectReference Include="..\WMS.Api\WMS.Api.csproj" />
  </ItemGroup>

</Project>

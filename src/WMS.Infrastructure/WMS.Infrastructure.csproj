<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!--
      Mismo id que WMS.Api a propósito: los user secrets son de la aplicación,
      no del proyecto que los lee. Aquí hace falta para que AppDbContextDesignTimeFactory
      encuentre ConnectionStrings:DefaultConnection al crear migraciones con `dotnet ef`.
    -->
    <UserSecretsId>Warehouse-API-8c3f1b7a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <!--
      Para JwtTokenService (adaptador de ITokenService): JwtSecurityToken y
      SymmetricSecurityKey. Configuration.Abstractions porque solo se lee
      IConfiguration, no se enlaza configuración.
    -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.*" />
    <!-- Adapter de persistencia: AppDbContext : IdentityDbContext + provider Npgsql. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
    <!--
      Tooling de migraciones: solo para `dotnet ef` (PrivateAssets), nunca en runtime.
      El startup es WMS.Api, que también lo declara.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Entidades (User, RefreshToken, …) que persiste el adaptador. -->
    <ProjectReference Include="..\WMS.Domain\WMS.Domain.csproj" />
    <!-- Adaptador de salida: implementa los puertos de WMS.Application. -->
    <ProjectReference Include="..\WMS.Application\WMS.Application.csproj" />
    <!--
      Puente transitorio de la migración: las entidades (Api.Products.Product, …) y los
      servicios siguen en src/Api hasta T10-T15. Desaparece cuando el último
      módulo pase a WMS.Domain / WMS.Application.
    -->
    <ProjectReference Include="..\Api\Api.csproj" />
  </ItemGroup>

</Project>
